# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=generate-a-long-random-value
DATABASE_URL=sqlite:///humisense.db
FLASK_ENV=production

# Mail (required for enquiry notifications)
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Public site origin used for canonical URLs and sitemap entries
SITE_BASE_URL=https://humisense.com
